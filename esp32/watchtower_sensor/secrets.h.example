/* 本机密钥文件 —— 绝不要提交到 Git、不要发到群里、不要贴到任何对话里。
 * 真正的 secrets.h 由你自己填；这里只是模板。
 *
 * 三个值分别从哪来：
 *   WIFI_SSID / WIFI_PASSWORD → 你家 2.4GHz 的 WiFi（ESP32 连不上 5GHz）
 *   DEVICE_TOKEN              → 服务器上执行：sudo cat /home/deploy/watchtower/.env
 *                               复制 WATCHTOWER_DEVICE_TOKEN= 后面那一长串（64 位）
 */
#pragma once

#define WIFI_SSID     "你的WiFi名"
#define WIFI_PASSWORD "你的WiFi密码"
#define DEVICE_TOKEN  "服务器上那串64位令牌"
